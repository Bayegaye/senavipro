# Copiez ce fichier en ".env" pour un usage local avec ces réglages, ou
# définissez ces variables directement dans les paramètres de votre
# hébergeur (Render, Railway, etc.). Aucune n'est obligatoire pour un usage
# purement local avec start.bat/start.sh (des valeurs par défaut sûres sont
# utilisées automatiquement).

# Clé secrète Flask (sessions, cookies). OBLIGATOIRE en production.
# Générez-en une avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# URL de connexion à la base de données. Si absente, SQLite local est utilisé
# (déconseillé en hébergement : le disque est souvent effacé à chaque déploiement).
# Exemple PostgreSQL : postgresql://utilisateur:motdepasse@hote:5432/nom_base
DATABASE_URL=

# Mot de passe du compte admin créé automatiquement au premier démarrage.
# Si absent, la valeur par défaut "senavipro2026" est utilisée — à éviter en production.
ADMIN_PASSWORD=

# Port d'écoute (la plupart des hébergeurs le définissent automatiquement).
PORT=5000
